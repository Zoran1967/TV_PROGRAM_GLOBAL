<SearchView>:
    orientation: "vertical"
    padding: dp(16), dp(8), dp(16), dp(8)
    spacing: dp(8)

    MDTextField:
        id: query
        hint_text: app.t("search_hint")
        mode: "rectangle"
        line_color_focus: app.colors["gold"]
        hint_text_color_focus: app.colors["gold"]
        on_text: root.schedule_search(self.text)

    MDLabel:
        text: root.status_text
        theme_text_color: "Custom"
        text_color: app.colors["text_muted"]
        size_hint_y: None
        height: self.texture_size[1]

    MDLabel:
        text: root.selected_text
        theme_text_color: "Custom"
        text_color: app.colors["gold"]
        size_hint_y: None
        height: self.texture_size[1]

    MDScrollView:
        MDList:
            id: results

MDScreen:
    md_bg_color: app.colors["navy"]

    MDBoxLayout:
        orientation: "vertical"
        padding: [0, app.inset_top, 0, app.inset_bottom]

        MDTopAppBar:
            title: app.t("app_title")
            md_bg_color: app.colors["navy_light"]
            specific_text_color: app.colors["gold"]
            elevation: 0

        MDBottomNavigation:
            panel_color: app.colors["navy_light"]
            text_color_active: app.colors["gold"]
            text_color_normal: app.colors["text_muted"]

            MDBottomNavigationItem:
                name: "search"
                text: app.t("tab_search")
                icon: "magnify"

                SearchView:

            MDBottomNavigationItem:
                name: "favourites"
                text: app.t("tab_favourites")
                icon: "star-outline"

                MDBoxLayout:
                    orientation: "vertical"
                    padding: dp(24)
                    spacing: dp(16)

                    MDLabel:
                        text: app.t("favourites_title")
                        halign: "center"
                        font_style: "H5"
                        theme_text_color: "Custom"
                        text_color: app.colors["gold"]
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        text: app.t("favourites_placeholder")
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: app.colors["text_muted"]

            MDBottomNavigationItem:
                name: "settings"
                text: app.t("tab_settings")
                icon: "cog-outline"

                MDBoxLayout:
                    orientation: "vertical"
                    padding: dp(24)
                    spacing: dp(16)

                    MDLabel:
                        text: app.t("settings_title")
                        halign: "center"
                        font_style: "H5"
                        theme_text_color: "Custom"
                        text_color: app.colors["gold"]
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        text: app.t("settings_placeholder")
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: app.colors["text_muted"]
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        text: app.t("about_title")
                        font_style: "Subtitle1"
                        theme_text_color: "Custom"
                        text_color: app.colors["gold"]
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        text: app.runtime_info
                        theme_text_color: "Custom"
                        text_color: app.colors["text_muted"]
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        text: app.t("about_note")
                        theme_text_color: "Custom"
                        text_color: app.colors["text_muted"]
